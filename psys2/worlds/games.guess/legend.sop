@legend.games.guess core.legend
    namespace=games.guess
    version=0.1.0
    imports=core
    imports=kids.common
    imports=kids.animals
    doc="The guessing game and what it learns"

@games.guess.learned core.type
    extends=core.state
    doc="An animal the player taught the system after a lost game, with the traits the answers revealed (session fact)."
    example="It was a zebra."

@games.guess.learned.animal core.key
    value=atom
    card=one
    ask="Which animal was it?"

@games.guess.learned.trait core.key
    value=string
    card=many
    ask="Which traits did the answers reveal (feature=value)?"
