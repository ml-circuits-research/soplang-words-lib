@k.objects.car.cabin.p4 k.objects.point part=$k.objects.car.cabin n=4 x=78 y=45 core.source="hand-core 1"
@k.objects.car.left_window.p1 k.objects.point part=$k.objects.car.left_window n=1 x=30 y=43 core.source="hand-core 1"
@k.objects.car.left_window.p2 k.objects.point part=$k.objects.car.left_window n=2 x=35 y=29 core.source="hand-core 1"
@k.objects.car.left_window.p3 k.objects.point part=$k.objects.car.left_window n=3 x=48 y=29 core.source="hand-core 1"
@k.objects.car.left_window.p4 k.objects.point part=$k.objects.car.left_window n=4 x=48 y=43 core.source="hand-core 1"
@k.objects.car.right_window.p1 k.objects.point part=$k.objects.car.right_window n=1 x=52 y=43 core.source="hand-core 1"
@k.objects.car.right_window.p2 k.objects.point part=$k.objects.car.right_window n=2 x=52 y=29 core.source="hand-core 1"
@k.objects.car.right_window.p3 k.objects.point part=$k.objects.car.right_window n=3 x=66 y=29 core.source="hand-core 1"
@k.objects.car.right_window.p4 k.objects.point part=$k.objects.car.right_window n=4 x=73 y=43 core.source="hand-core 1"

# boat
@k.objects.boat k.objects.object name=boat core.source="hand-core 1"
@k.objects.boat.hull k.objects.part of=boat name=hull shape=polygon x=5 y=60 w=90 h=25 z=1 colour=brown colour=white colour=red centered=true core.source="hand-core 1"
