@k.objects.rocket.right_fin.p3 k.objects.point part=$k.objects.rocket.right_fin n=3 x=80 y=90 core.source="hand-core 1"

# train
@k.objects.train k.objects.object name=train core.source="hand-core 1"
@k.objects.train.engine k.objects.part of=train name=engine shape=rectangle x=5 y=40 w=55 h=35 z=1 colour=red colour=green colour=black core.source="hand-core 1"
@k.objects.train.cabin k.objects.part of=train name=cabin shape=rectangle x=40 y=20 w=20 h=20 z=1 colour=red colour=green colour=black above=engine core.source="hand-core 1"
@k.objects.train.window k.objects.part of=train name=window shape=square x=44 y=24 w=12 h=12 z=2 colour=blue inside=cabin core.source="hand-core 1"
@k.objects.train.chimney k.objects.part of=train name=chimney shape=rectangle x=12 y=25 w=8 h=15 z=1 colour=black on=engine core.source="hand-core 1"
@k.objects.train.carriage k.objects.part of=train name=carriage shape=rectangle x=62 y=45 w=33 h=30 z=1 colour=blue colour=red colour=green right_of=engine core.source="hand-core 1"
@k.objects.train.first_wheel k.objects.part of=train name=first_wheel kind=wheel shape=circle x=10 y=70 w=14 h=14 z=2 colour=black below=engine core.source="hand-core 1"
@k.objects.train.second_wheel k.objects.part of=train name=second_wheel kind=wheel shape=circle x=38 y=70 w=14 h=14 z=2 colour=black below=engine core.source="hand-core 1"
@k.objects.train.third_wheel k.objects.part of=train name=third_wheel kind=wheel shape=circle x=66 y=70 w=14 h=14 z=2 colour=black below=carriage core.source="hand-core 1"
@k.objects.train.fourth_wheel k.objects.part of=train name=fourth_wheel kind=wheel shape=circle x=80 y=70 w=14 h=14 z=2 colour=black below=carriage core.source="hand-core 1"

# bicycle
@k.objects.bicycle k.objects.object name=bicycle core.source="hand-core 1"
@k.objects.bicycle.back_wheel k.objects.part of=bicycle name=back_wheel kind=wheel shape=circle x=3 y=50 w=36 h=36 z=1 colour=black left_of=front_wheel core.source="hand-core 1"
@k.objects.bicycle.front_wheel k.objects.part of=bicycle name=front_wheel kind=wheel shape=circle x=61 y=50 w=36 h=36 z=1 colour=black right_of=back_wheel core.source="hand-core 1"
