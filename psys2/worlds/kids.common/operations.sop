@op.kids.common.greet core.operation
    impl=greet
    semantics=action
    action=chat.greet
    doc="Greets back."

@op.kids.common.name core.operation
    impl=assistantName
    semantics=action
    action=chat.name
    doc="Tells the assistant's name: the name of the avatar when ui.avatar is loaded (they are one character, ctx.request(\"avatar.nameOf\")), else the name of e.assistant."

@op.kids.common.meet core.operation
    impl=meet
    semantics=action
    action=chat.meet
    doc="The user says their name (arg.name): remembers it in the session (ctx.state.userName) and greets them by it."

@op.kids.common.myname core.operation
    impl=myName
    semantics=action
    action=chat.myname
    doc="Tells the user's name when they said it earlier in the session, else asks for it."

@op.kids.common.who core.operation
    impl=assistantName
    semantics=action
    action=chat.who
    doc="Says who the assistant is."

@op.kids.common.thanks core.operation
    impl=thanks
    semantics=action
    action=chat.thanks
    doc="Answers thanks."

@op.kids.common.bye core.operation
    impl=bye
    semantics=action
    action=chat.bye
    doc="Says goodbye."

@op.kids.common.howru core.operation
    impl=howAreYou
    semantics=action
    action=chat.howru
    doc="Small talk: how the assistant is. A friendly fixed answer."

@op.kids.common.ask core.operation
    impl=ask
    semantics=action
    action=chat.ask
    doc="Clarification for a question without its subject (\"How many legs?\", \"What day is after?\"): asks arg.q and leaves the answer pending; arg.template (with <x>) completes the sentence in arg.world (spec 11 section 3)."

@op.kids.common.listen core.operation
    impl=listen
    semantics=action
    action=chat.listen
    doc="The user announces something they want to tell (\"I should tell you ...\"): an acknowledgement, no action and no to-do item (GAPS-1)."
