# plane
@k.objects.plane k.objects.object name=plane core.source="hand-core 1"
@k.objects.plane.body k.objects.part of=plane name=body shape=oval x=8 y=42 w=84 h=16 z=1 colour=white colour=grey core.source="hand-core 1"
@k.objects.plane.tail k.objects.part of=plane name=tail shape=polygon x=4 y=24 w=24 h=22 z=0 colour=red colour=grey above=body core.source="hand-core 1"
