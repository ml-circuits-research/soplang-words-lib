# k.objects/shards/animals: cat, dog, fish, bird, butterfly. Parts with a primitive shape, a box in the 0 to 100 frame
# of the object (x right, y down), a draw order z and typical colours; points for lines and polygons.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: none (hand-written)

# cat
@k.objects.cat k.objects.object name=cat core.source="hand-core 1"
@k.objects.cat.body k.objects.part of=cat name=body shape=oval x=30 y=50 w=50 h=35 z=1 colour=grey colour=black colour=orange core.source="hand-core 1"
@k.objects.cat.head k.objects.part of=cat name=head shape=circle x=8 y=25 w=34 h=34 z=2 colour=grey colour=black colour=orange left_of=body core.source="hand-core 1"
@k.objects.cat.left_ear k.objects.part of=cat name=left_ear kind=ear shape=triangle x=10 y=15 w=12 h=14 z=1 colour=grey colour=black colour=orange above=head core.source="hand-core 1"
@k.objects.cat.right_ear k.objects.part of=cat name=right_ear kind=ear shape=triangle x=28 y=15 w=12 h=14 z=1 colour=grey colour=black colour=orange above=head core.source="hand-core 1"
@k.objects.cat.left_eye k.objects.part of=cat name=left_eye kind=eye shape=circle x=16 y=36 w=6 h=6 z=3 colour=green inside=head core.source="hand-core 1"
@k.objects.cat.right_eye k.objects.part of=cat name=right_eye kind=eye shape=circle x=28 y=36 w=6 h=6 z=3 colour=green inside=head core.source="hand-core 1"
@k.objects.cat.tail k.objects.part of=cat name=tail shape=line x=80 y=35 w=12 h=35 z=0 colour=grey colour=black colour=orange right_of=body core.source="hand-core 1"
@k.objects.cat.front_leg k.objects.part of=cat name=front_leg kind=leg shape=rectangle x=35 y=80 w=7 h=15 z=0 colour=grey colour=black colour=orange below=body core.source="hand-core 1"
@k.objects.cat.back_leg k.objects.part of=cat name=back_leg kind=leg shape=rectangle x=68 y=80 w=7 h=15 z=0 colour=grey colour=black colour=orange below=body core.source="hand-core 1"
@k.objects.cat.tail.p1 k.objects.point part=$k.objects.cat.tail n=1 x=80 y=70 core.source="hand-core 1"
@k.objects.cat.tail.p2 k.objects.point part=$k.objects.cat.tail n=2 x=90 y=55 core.source="hand-core 1"
@k.objects.cat.tail.p3 k.objects.point part=$k.objects.cat.tail n=3 x=92 y=35 core.source="hand-core 1"

# dog
@k.objects.dog k.objects.object name=dog core.source="hand-core 1"
@k.objects.dog.body k.objects.part of=dog name=body shape=oval x=32 y=45 w=53 h=28 z=1 colour=brown colour=black colour=white core.source="hand-core 1"
@k.objects.dog.head k.objects.part of=dog name=head shape=circle x=10 y=20 w=30 h=30 z=2 colour=brown colour=black colour=white left_of=body core.source="hand-core 1"
@k.objects.dog.snout k.objects.part of=dog name=snout shape=oval x=2 y=34 w=18 h=13 z=3 colour=brown colour=white left_of=head core.source="hand-core 1"
@k.objects.dog.nose k.objects.part of=dog name=nose shape=circle x=2 y=35 w=5 h=5 z=4 colour=black inside=snout core.source="hand-core 1"
@k.objects.dog.mouth k.objects.part of=dog name=mouth shape=line x=6 y=44 w=9 h=1 z=4 colour=black inside=snout core.source="hand-core 1"
@k.objects.dog.ear k.objects.part of=dog name=ear shape=oval x=28 y=18 w=10 h=24 z=3 colour=black colour=brown on=head core.source="hand-core 1"
@k.objects.dog.eye k.objects.part of=dog name=eye shape=circle x=18 y=27 w=4 h=4 z=3 colour=black inside=head core.source="hand-core 1"
@k.objects.dog.tail k.objects.part of=dog name=tail shape=line x=84 y=38 w=11 h=16 z=0 colour=brown colour=black colour=white right_of=body core.source="hand-core 1"
@k.objects.dog.front_leg k.objects.part of=dog name=front_leg kind=leg shape=rectangle x=38 y=68 w=7 h=27 z=0 colour=brown colour=black colour=white below=body core.source="hand-core 1"
@k.objects.dog.back_leg k.objects.part of=dog name=back_leg kind=leg shape=rectangle x=72 y=68 w=7 h=27 z=0 colour=brown colour=black colour=white below=body core.source="hand-core 1"
@k.objects.dog.mouth.p1 k.objects.point part=$k.objects.dog.mouth n=1 x=6 y=44 core.source="hand-core 1"
@k.objects.dog.mouth.p2 k.objects.point part=$k.objects.dog.mouth n=2 x=15 y=45 core.source="hand-core 1"
@k.objects.dog.tail.p1 k.objects.point part=$k.objects.dog.tail n=1 x=84 y=54 core.source="hand-core 1"
@k.objects.dog.tail.p2 k.objects.point part=$k.objects.dog.tail n=2 x=95 y=38 core.source="hand-core 1"

# fish
@k.objects.fish k.objects.object name=fish core.source="hand-core 1"
@k.objects.fish.body k.objects.part of=fish name=body shape=oval x=10 y=30 w=60 h=40 z=1 colour=orange colour=blue colour=grey core.source="hand-core 1"
