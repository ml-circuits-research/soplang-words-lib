# k.objects/shards/home: sofa, shelf, oven, bottle, box, suitcase, bag, phone, computer, book. Parts with a primitive shape, a box in the 0 to 100 frame
# of the object (x right, y down), a draw order z and typical colours; points for lines and polygons.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: none (hand-written)

# sofa
@k.objects.sofa k.objects.object name=sofa core.source="hand-core 1"
@k.objects.sofa.back k.objects.part of=sofa name=back shape=rectangle x=15 y=30 w=70 h=30 z=1 colour=blue colour=red colour=green core.source="hand-core 1"
@k.objects.sofa.seat k.objects.part of=sofa name=seat shape=rectangle x=15 y=55 w=70 h=20 z=2 colour=blue colour=red colour=green below=back core.source="hand-core 1"
@k.objects.sofa.left_arm k.objects.part of=sofa name=left_arm kind=arm shape=rectangle x=5 y=42 w=12 h=38 z=3 colour=blue colour=red colour=green left_of=seat core.source="hand-core 1"
@k.objects.sofa.right_arm k.objects.part of=sofa name=right_arm kind=arm shape=rectangle x=83 y=42 w=12 h=38 z=3 colour=blue colour=red colour=green right_of=seat core.source="hand-core 1"
@k.objects.sofa.left_leg k.objects.part of=sofa name=left_leg kind=leg shape=rectangle x=10 y=80 w=5 h=10 z=0 colour=brown below=seat core.source="hand-core 1"
@k.objects.sofa.right_leg k.objects.part of=sofa name=right_leg kind=leg shape=rectangle x=85 y=80 w=5 h=10 z=0 colour=brown below=seat core.source="hand-core 1"

