@gen.ui.avatar core.note
    text="Generated by scripts/legend-from-dicebear.mjs from DiceBear 10.7.0 (styles 10.6.0); do not edit by hand"

@legend.ui.avatar core.legend
    namespace=ui.avatar
    version=0.2.0
    imports=core
    imports=kids.common
    doc="The avatar: a character drawn by DiceBear (robot = voxel-bot, person = open-peeps, emoji = moods, portrait = lorelei, cartoon = micah, kid = big-smile, pixel_person = pixel-art, pixel_robot = pixelbot, fun_emoji = fun-emoji). The types, keys and variants below are the style definitions of the library."

@ui.avatar.character core.type
    extends=core.state
    doc="Which character is shown, its name and the seed that drew it. The world state holds character, name, seed and one object per character style."
    example="Become a person."

@ui.avatar.character.active core.key
    value=atom
    card=one
    ask="Which character are you (robot, person, emoji, portrait, cartoon, kid, pixel_person, pixel_robot, fun_emoji)?"
    doc="One of: robot, person, emoji, portrait, cartoon, kid, pixel_person, pixel_robot, fun_emoji."

@ui.avatar.character.name core.key
    value=string
    card=one
    ask="What is your name?"

@ui.avatar.character.seed core.key
    value=string
    card=one
    ask="Which seed drew you?"

@ui.avatar.robot core.type
    extends=core.state
