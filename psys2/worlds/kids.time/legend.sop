@legend.kids.time core.legend
    namespace=kids.time
    version=0.1.0
    imports=core
    imports=kids.common
    doc="Calendar and clock knowledge for primary school"

@kids.time.dayinfo core.type
    extends=core.state
    doc="A day of the week with its place in the week."
    example="Monday is the first day of the week."

@kids.time.dayinfo.name core.key
    value=atom
    card=one
    ask="Which day of the week?"

@kids.time.dayinfo.index core.key
    value=integer
    card=one
    ask="Which place in the week (1 = Monday)?"

@kids.time.dayinfo.kind core.key
    value=atom
    card=one
    ask="Is it a school day or a weekend day?"

@kids.time.monthinfo core.type
    extends=core.state
    doc="A month of the year with its length and season."
    example="March has 31 days and is a spring month."

@kids.time.monthinfo.name core.key
    value=atom
    card=one
    ask="Which month?"

@kids.time.monthinfo.index core.key
    value=integer
    card=one
    ask="Which place in the year (1 = January)?"

@kids.time.monthinfo.days core.key
    value=integer
    card=one
    ask="How many days does the month have?"
    compute=true
@kids.time.monthinfo.season core.key
    value=atom
    card=one
    ask="Which season is the month in (northern hemisphere)?"

@kids.time.monthinfo.remark core.key
    value=string
    card=one
    ask="Is there something special about the length?"

@kids.time.seasoninfo core.type
    extends=core.state
    doc="A season with its place in the year."
    example="Spring comes after winter."

@kids.time.seasoninfo.name core.key
    value=atom
    card=one
    ask="Which season?"

@kids.time.seasoninfo.index core.key
    value=integer
    card=one
    ask="Which place in the year (1 = spring)?"

@kids.time.length core.type
    extends=core.state
    doc="How many smaller time spans fit in a bigger one."
    example="A week has 7 days."

@kids.time.length.whole core.key
    value=atom
    card=one
    ask="Which time span (week, year, day, hour, minute, month)?"

@kids.time.length.part core.key
    value=atom
    card=one
    ask="Which smaller time span is counted?"

@kids.time.length.times core.key
    value=number
    card=one
    ask="How many of the bigger spans?"

@kids.time.length.count core.key
    value=number
    card=one
    ask="How many are there?"
    compute=true
@kids.time.today core.type
    extends=core.state
    doc="Which day of the week it is today (told in the dialog)."
    example="Today is Friday."

@kids.time.today.day core.key
    value=atom
    card=one
    ask="Which day is it today?"

@kids.time.thismonth core.type
    extends=core.state
    doc="Which month it is now (told in the dialog)."
    example="This month is May."

@kids.time.thismonth.month core.key
    value=atom
    card=one
    ask="Which month is it now?"

@kids.time.clockset core.type
    extends=core.state
    doc="What the clock shows now (told in the dialog)."
    example="It is 3 o'clock."

@kids.time.clockset.hour core.key
    value=number
    card=one
    ask="Which hour does the clock show?"

@kids.time.shift core.type
    extends=core.state
    doc="Which day, month or season comes some steps after or before another one."
    example="What day comes after Monday?"

@kids.time.shift.unit core.key
    value=atom
    card=one
    ask="Is it about days, months or seasons?"

@kids.time.shift.from core.key
    value=atom
    card=one
    ask="From which day, month or season (or today, this_month)?"

@kids.time.shift.by core.key
    value=number
    card=one
    ask="How many steps (negative for before)?"

@kids.time.shift.result core.key
    value=atom
    card=one
    ask="Which day, month or season is it?"
    compute=true
@kids.time.gap core.type
    extends=core.state
    doc="How many days from one day of the week to the next time another one comes."
    example="How many days until Friday if today is Monday?"

@kids.time.gap.from core.key
    value=atom
    card=one
    ask="From which day (or today)?"

@kids.time.gap.to core.key
    value=atom
    card=one
    ask="Until which day?"

@kids.time.gap.count core.key
    value=integer
    card=one
    ask="How many days are there?"
    compute=true
@kids.time.hoursgap core.type
    extends=core.state
    doc="How many hours from one o'clock to another on a 12-hour clock."
    example="How many hours from 3 o'clock to 7 o'clock?"

@kids.time.hoursgap.from core.key
    value=number
    card=one
    ask="From which hour?"

@kids.time.hoursgap.to core.key
    value=number
    card=one
    ask="Until which hour?"

@kids.time.hoursgap.count core.key
    value=integer
    card=one
    ask="How many hours are there?"
    compute=true
@kids.time.clock core.type
    extends=core.state
    doc="The time on a 12-hour clock some hours or minutes after or before another time."
    example="If it is 3 o'clock, what time will it be in 2 hours?"

@kids.time.clock.at core.key
    value=number
    card=one
    ask="Which hour does the clock show now?"

@kids.time.clock.shift core.key
    value=number
    card=one
    ask="How many hours later (negative for earlier)?"

@kids.time.clock.minutes core.key
    value=number
    card=one
    ask="How many minutes later (negative for earlier)?"

@kids.time.clock.result core.key
    value=string
    card=one
    ask="What time is it then?"
    compute=true
@kids.time.reading core.type
    extends=core.state
    doc="What time it is now."
    example="What time is it?"

@kids.time.reading.time core.key
    value=string
    card=one
    ask="What time is it now?"
    compute=true

@kids.time.seasonshift core.type
    extends=core.state
    doc="Which season comes some steps after or before another one."
    example="Which season comes after winter?"

@kids.time.seasonshift.unit core.key
    value=atom
    card=one
    ask="Is it about seasons?"

@kids.time.seasonshift.from core.key
    value=atom
    card=one
    ask="From which season?"

@kids.time.seasonshift.by core.key
    value=number
    card=one
    ask="How many steps (negative for before)?"

@kids.time.seasonshift.result core.key
    value=atom
    card=one
    ask="Which season is it?"
    compute=true
