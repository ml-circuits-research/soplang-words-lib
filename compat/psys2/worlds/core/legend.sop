    required=true

@core.test.expect core.key
    value=string
    card=many
    ask="Which substring must the answer contain?"

@core.test.expectStatus core.key
    value=atom
    card=one
    ask="Which answer status is expected?"

@core.test.expectState core.key
    value=string
    card=many
    ask="Which state value must hold after the input (<dot.path>=<value>, optionally <worldId>:<dot.path>=<value>)?"

@core.test.expectEffect core.key
    value=atom
    card=many
    ask="Which effect must have been queued by the input?"

