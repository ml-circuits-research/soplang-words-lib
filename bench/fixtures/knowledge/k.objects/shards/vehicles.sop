@k.objects.rocket.left_fin k.objects.part of=rocket name=left_fin kind=fin shape=polygon x=20 y=60 w=15 h=30 z=1 colour=red left_of=body core.source="hand-core 1"
@k.objects.rocket.right_fin k.objects.part of=rocket name=right_fin kind=fin shape=polygon x=65 y=60 w=15 h=30 z=1 colour=red right_of=body core.source="hand-core 1"
@k.objects.rocket.flame k.objects.part of=rocket name=flame shape=triangle x=40 y=80 w=20 h=17 z=0 colour=orange colour=yellow pointing=down below=body centered=true core.source="hand-core 1"
@k.objects.rocket.left_fin.p1 k.objects.point part=$k.objects.rocket.left_fin n=1 x=35 y=60 core.source="hand-core 1"
@k.objects.rocket.left_fin.p2 k.objects.point part=$k.objects.rocket.left_fin n=2 x=35 y=80 core.source="hand-core 1"
