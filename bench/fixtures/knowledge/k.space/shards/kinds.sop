@k.space.kind.comet k.space.kind name=comet made_of=ice made_of=dust orbits=star has=tail drawing=comet core.source="hand-core 1"
@k.space.kind.asteroid k.space.kind name=asteroid made_of=rock made_of=metal orbits=star core.source="hand-core 1"
@k.space.kind.galaxy k.space.kind name=galaxy made_of=stars made_of=gas made_of=dust drawing="milky way" core.source="hand-core 1"
@k.space.kind.solar_system k.space.kind name="solar system" made_of=Sun made_of=planets made_of=moons made_of=comets made_of=asteroids core.source="hand-core 1"

