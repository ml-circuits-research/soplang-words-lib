# butterfly
@k.objects.butterfly k.objects.object name=butterfly core.source="hand-core 1"
@k.objects.butterfly.body k.objects.part of=butterfly name=body shape=oval x=46 y=25 w=8 h=50 z=2 colour=black centered=true core.source="hand-core 1"
@k.objects.butterfly.left_upper_wing k.objects.part of=butterfly name=left_upper_wing kind=wing shape=oval x=10 y=15 w=38 h=35 z=1 colour=purple colour=orange colour=yellow colour=blue left_of=body core.source="hand-core 1"
@k.objects.butterfly.right_upper_wing k.objects.part of=butterfly name=right_upper_wing kind=wing shape=oval x=52 y=15 w=38 h=35 z=1 colour=purple colour=orange colour=yellow colour=blue right_of=body core.source="hand-core 1"
@k.objects.butterfly.left_lower_wing k.objects.part of=butterfly name=left_lower_wing kind=wing shape=oval x=18 y=48 w=30 h=30 z=1 colour=purple colour=orange colour=yellow colour=blue left_of=body core.source="hand-core 1"
@k.objects.butterfly.right_lower_wing k.objects.part of=butterfly name=right_lower_wing kind=wing shape=oval x=52 y=48 w=30 h=30 z=1 colour=purple colour=orange colour=yellow colour=blue right_of=body core.source="hand-core 1"
@k.objects.butterfly.left_antenna k.objects.part of=butterfly name=left_antenna kind=antenna shape=line x=40 y=10 w=8 h=16 z=2 colour=black above=body core.source="hand-core 1"
@k.objects.butterfly.right_antenna k.objects.part of=butterfly name=right_antenna kind=antenna shape=line x=52 y=10 w=8 h=16 z=2 colour=black above=body core.source="hand-core 1"
@k.objects.butterfly.left_antenna.p1 k.objects.point part=$k.objects.butterfly.left_antenna n=1 x=48 y=26 core.source="hand-core 1"
@k.objects.butterfly.left_antenna.p2 k.objects.point part=$k.objects.butterfly.left_antenna n=2 x=40 y=10 core.source="hand-core 1"
@k.objects.butterfly.right_antenna.p1 k.objects.point part=$k.objects.butterfly.right_antenna n=1 x=52 y=26 core.source="hand-core 1"
@k.objects.butterfly.right_antenna.p2 k.objects.point part=$k.objects.butterfly.right_antenna n=2 x=60 y=10 core.source="hand-core 1"

# words
@k.objects.word.cat core.word text=cat text=cats text=kitten means=cat of=k.objects.object.name core.source="hand-core 1"
@k.objects.word.dog core.word text=dog text=dogs text=puppy means=dog of=k.objects.object.name core.source="hand-core 1"
