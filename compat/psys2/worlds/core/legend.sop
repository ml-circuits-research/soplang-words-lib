    value=atom
    card=one
    ask="Which language is the input in?"

@core.test.session core.key
    value=atom
    card=one
    ask="Which tests share a session?"

@core.test.doc core.key
    value=string
    card=one
    ask="What is tested?"

@core.lexicon.class core.key
    value=atom
    card=one
    ask="Which class of words?"
    required=true

@core.lexicon.word core.key
    value=atom
    card=many
    ask="Which words?"

@core.lexicon.plural core.key
    value=atom
    card=many
    ask="Which irregular plurals (singular:plural)?"

@core.lexicon.gender core.key
    value=atom
