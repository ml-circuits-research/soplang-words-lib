@world.diagram.sketch core.world
    namespace=diagram.sketch
    version=0.1.0
    legend=$legend.diagram.sketch
    imports=world.core
    imports=world.lang.common
    formalization=rules
    language=en
    status=fixture
    title="Diagram editor (from diagram-vss-demo)"
    summary="draw diagrams"
    tab=diagram
    tabTitle="Diagram"
    tabAlias=diagrams
    tabAlias=diagram_editor
    tabAlias=flowchart
    tabAlias=flow_chart
    tabAlias=org_chart
    tabAlias=sketchpad
    tabAlias=canvas
    tabOrder=85
    tabKind=tool
    tabNew=diagram.new
    doc="A diagram editor controlled by text or voice, imported from diagram-vss-demo (commit 9900d34, AGPL-3.0): named shapes (circle, square, rectangle, triangle, diamond, ellipse, hexagon, star, text) with colour, outline, fill, size, label and place; connections (solid, dashed, dotted; arrow forward, both, none; chains and fan-outs); groups, zones and backgrounds; align, arrange (row, column, grid, circle, tree, layers, radial), distribute, z-order; 24 diagram templates (process, cycle, hierarchy, pyramid, funnel ...) and colour schemes; questions about the drawing (count, list, exists, property, check, describe, neighbours, degree, nearest, extreme, path, reachable, cycle) answered by the engine's Datalog reasoner; facts and rules; undo and redo. The state and the execution are the source engine (engine/, converted by scripts/convert-diagram-engine.mjs), wrapped by ops.mjs; the patterns recognise the act from the legend's cue words and hand the sentence to the engine's own rules reader; the Diagram tab renders the state as SVG (ported from the source's ui.js). Imported platform fixture, not produced by the C1 workflow."
