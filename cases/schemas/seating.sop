# A seating plan as data, after PSys2's handover/acts executor tests (the behaviour to match);
# the acts per kind and the tables' place follow PSys2's plan.seating grid (cases/grid.cases.json).
@acts core.use world=std.acts
@seating std.schema.world name=seating doc="tables and guests"
@t.table core.type of=table extends=std.schema.thing closed=true
@t.guest core.type of=guest extends=std.schema.thing closed=true
@s.table.colour core.slot of=table key=colour enum=white enum=blue enum=red default=white
@s.table.seats core.slot of=table key=seats kind=integer min=1 max=12 step=1 default=4
@s.guest.name core.slot of=guest key=name required=true
@s.guest.at core.slot of=guest key=at type=table
@s.table.x core.slot of=table key=x kind=number
@s.table.y core.slot of=table key=y kind=number
@k.table std.schema.kind of=table world=seating acts=make acts=change acts=remove acts=ask acts=copy acts=connect acts=group acts=place acts=save acts=load
@k.guest std.schema.kind of=guest world=seating acts=make acts=change acts=remove acts=ask acts=place acts=copy acts=connect acts=group
@l.table std.schema.limit of=table max=8
@cap std.schema.capacity of=table key=seats holds=guest via=at
