@legend.games.chess core.legend
    namespace=games.chess
    version=0.1.0
    imports=core
    imports=kids.common
    doc="Chess game state"

@games.chess.game core.type
    extends=core.state
    doc="A game of chess. The world state holds fen, history (SAN list), user (white or black), turn, status (playing, checkmate, stalemate, draw, resigned), level (1 to 8), lastMove, pendingEngine, orientation and the data the board needs (legal destinations, captured pieces, highlights)."
    example="Knight to f3."

@games.chess.game.level core.key
    value=integer
    card=one
    ask="Which level (1 to 8) should I play at?"

@games.chess.game.user core.key
    value=atom
    card=one
    ask="Which colour do you play (white or black)?"
