# k.objects/shards/things: gun, suit, tape, bullet, sword, fan, painting, map, horn, trap, screen, tank, rope, mask, shoe, doorbell, cage, pipe, frame, underwear, shell, pole, string, tube, pan, throne. Parts with a primitive shape, a box in the 0 to 100 frame
# of the object (x right, y down), a draw order z and typical colours; points for lines and polygons.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: none (hand-written)

# gun
@k.objects.gun k.objects.object name=gun core.source="hand-core 1"
@k.objects.gun.barrel k.objects.part of=gun name=barrel shape=rectangle x=14 y=30 w=62 h=14 z=1 colour=grey colour=black core.source="hand-core 1"
@k.objects.gun.grip k.objects.part of=gun name=grip shape=polygon x=56 y=44 w=26 h=38 z=1 colour=brown colour=black below=barrel core.source="hand-core 1"
@k.objects.gun.trigger_guard k.objects.part of=gun name=trigger_guard shape=arc x=40 y=44 w=16 h=12 z=2 colour=grey colour=black opens=up below=barrel left_of=grip core.source="hand-core 1"
@k.objects.gun.trigger k.objects.part of=gun name=trigger shape=line x=49 y=44 w=2 h=8 z=3 colour=black below=barrel core.source="hand-core 1"
@k.objects.gun.hammer k.objects.part of=gun name=hammer shape=rectangle x=72 y=23 w=6 h=8 z=0 colour=grey colour=black above=grip core.source="hand-core 1"
@k.objects.gun.sight k.objects.part of=gun name=sight shape=square x=16 y=26 w=4 h=4 z=0 colour=grey colour=black above=barrel core.source="hand-core 1"
@k.objects.gun.muzzle k.objects.part of=gun name=muzzle shape=square x=14 y=34 w=6 h=6 z=2 colour=black inside=barrel core.source="hand-core 1"
