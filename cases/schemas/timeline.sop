# A timeline as data: moments in a row by time, after PSys2's plan.timeline world
# (its schema: one kind, moment, named, with when 0..3000, default 1; acts make, remove,
# change, ask, copy, send, undo, redo; at most 60 items). The grid cases are in
# cases/grid.cases.json.
@acts core.use world=std.acts
@timeline std.schema.world name=timeline doc="moments in a row by time"
@t.moment core.type of=moment extends=std.schema.thing closed=true
@s.moment.name core.slot of=moment key=name
@s.moment.when core.slot of=moment key=when kind=number min=0 max=3000 step=1 default=1
@k.moment std.schema.kind of=moment world=timeline acts=make acts=remove acts=change acts=ask acts=copy acts=send
@l.moment std.schema.limit of=moment max=60
