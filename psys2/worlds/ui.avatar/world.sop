@world.ui.avatar core.world
    namespace=ui.avatar
    version=0.2.0
    legend=$legend.ui.avatar
    imports=world.core
    imports=world.kids.common
    formalization=rules
    language=en
    status=fixture
    title="Avatar (DiceBear)"
    summary="change my face"
    doc="The avatar of the demo: a robot, a person or an emoji drawn by the DiceBear library and changed by voice or text: parts, colors, mood, name, seed. State lives in ctx.state; the host draws it. The legend.sop and lexicon.sop are generated from the DiceBear style definitions by scripts/legend-from-dicebear.mjs (an example of building a legend from a tool's documentation); the patterns, operations, templates and tests are hand-built. Platform fixture, not produced by the C1 workflow."
