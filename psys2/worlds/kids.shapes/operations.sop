@op.kids.shapes.holdsYes core.operation
    outputs=kids.shapes.family.holds
    inputs=kids.shapes.family.shape
    inputs=kids.shapes.family.kind
    impl=holdsYes
    semantics=query
    doc="Yes when the knowledge base (or the dialog) says the shape is of that kind."

@op.kids.shapes.holdsNo core.operation
    outputs=kids.shapes.family.holds
    inputs=kids.shapes.family.shape
    inputs=kids.shapes.family.kind
    impl=holdsNo
    semantics=query
    doc="No only when it is explicitly stated that the shape is not of that kind (refuted); otherwise missing (unknown). May carry the reason."

@op.kids.shapes.describeShape core.operation
    outputs=kids.shapes.shape.summary
    inputs=kids.shapes.shape.name
    impl=describeShape
    semantics=query
    doc="A short description from the number of sides and corners."

@op.kids.shapes.colorOf core.operation
    outputs=kids.shapes.thing.color
    inputs=kids.shapes.thing.name
    impl=colorOf
    semantics=query
    doc="The usual colors of a thing, with its name and article in the note."

@op.kids.shapes.colorYes core.operation
    outputs=kids.shapes.thing.is_color
    inputs=kids.shapes.thing.name
    inputs=kids.shapes.thing.is_color
    impl=colorYes
    semantics=query
    doc="Yes when the asked color is one of the usual colors of the thing."

@op.kids.shapes.colorNo core.operation
    outputs=kids.shapes.thing.is_color
    inputs=kids.shapes.thing.name
    inputs=kids.shapes.thing.is_color
    impl=colorNo
    semantics=query
    doc="No when the thing has known usual colors and the asked color is not one of them."

@op.kids.shapes.kindYes core.operation
    outputs=kids.shapes.color.is_kind
    inputs=kids.shapes.color.name
    inputs=kids.shapes.color.is_kind
    impl=kindYes
    semantics=query
    doc="Yes when the color is of the asked kind (primary, secondary, neutral)."

@op.kids.shapes.kindNo core.operation
    outputs=kids.shapes.color.is_kind
    inputs=kids.shapes.color.name
    inputs=kids.shapes.color.is_kind
    impl=kindNo
    semantics=query
    doc="No, with the actual kind, when the color is of another known kind."

@op.kids.shapes.mixResult core.operation
    outputs=kids.shapes.mix.result
    inputs=kids.shapes.mix.first
    inputs=kids.shapes.mix.second
    impl=mixResult
    semantics=query
    doc="What two colors make, in either order."

@op.kids.shapes.mixRecipe core.operation
    outputs=kids.shapes.mix.recipe
    inputs=kids.shapes.mix.result
    impl=mixRecipe
    semantics=query
    doc="Which two colors make a given color."
