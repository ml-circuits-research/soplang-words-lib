@legend.docs.editor core.legend
    namespace=docs.editor
    version=0.1.0
    imports=core
    imports=kids.common
    imports=kids.tasks
    imports=kids.animals
    imports=kids.arith
    doc="The document state"

@docs.editor.document core.type
    extends=core.state
    doc="The document being edited. The world state holds title (with its formatting), blocks (heading, paragraph, quote, list with bullet, numbered or task style, table, rule; each with inline mark ranges, alignment and the ids of the wires it was made from), cursor, selection, a derived TipTap JSON (doc), statistics, inputMode and the undo history."
    example="Add a heading Shopping."

@docs.editor.document.title core.key
    value=string
    card=one
    ask="What is the title of the document?"
