# k.objects/shards/more: truck, hen, bee, planet, heart, flag, hat, boot, sock. Parts with a primitive shape, a box in the 0 to 100 frame
# of the object (x right, y down), a draw order z and typical colours; points for lines and polygons.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: none (hand-written)

# truck
@k.objects.truck k.objects.object name=truck core.source="hand-core 1"
@k.objects.truck.cargo k.objects.part of=truck name=cargo shape=rectangle x=5 y=25 w=58 h=50 z=1 colour=red colour=blue colour=grey core.source="hand-core 1"
@k.objects.truck.cab k.objects.part of=truck name=cab shape=rectangle x=63 y=40 w=30 h=35 z=1 colour=red colour=blue colour=white right_of=cargo core.source="hand-core 1"
@k.objects.truck.window k.objects.part of=truck name=window shape=rectangle x=70 y=45 w=16 h=13 z=2 colour=blue colour=white inside=cab core.source="hand-core 1"
@k.objects.truck.back_wheel k.objects.part of=truck name=back_wheel kind=wheel shape=circle x=14 y=68 w=18 h=18 z=3 colour=black below=cargo core.source="hand-core 1"
@k.objects.truck.front_wheel k.objects.part of=truck name=front_wheel kind=wheel shape=circle x=68 y=68 w=18 h=18 z=3 colour=black below=window core.source="hand-core 1"
@k.objects.truck.headlight k.objects.part of=truck name=headlight shape=circle x=89 y=64 w=4 h=4 z=3 colour=yellow inside=cab core.source="hand-core 1"

