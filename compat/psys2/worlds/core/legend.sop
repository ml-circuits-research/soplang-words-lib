@core.template.when core.key
    value=string
    card=many
    ask="Which condition on a placeholder must hold (<name><op><value>, op one of = != > >= < <=, for example \"value=true\")? All conditions must hold."

@core.template.text core.key
    value=string
    card=one
    ask="Which text?"
    required=true

@core.template.doc core.key
    value=string
    card=one
    ask="What is it?"

@core.test.input core.key
