    card=one
    ask="What is the title?"

@core.world.summary core.key
    value=string
    card=one
    ask="What short phrase says what the world lets the assistant do (for example \"do sums\"; empty to leave it out of the capabilities answer)?"

@core.world.doc core.key
    value=string
    card=one
    ask="What is it about?"

@core.world.tab core.key
    value=atom
    card=one
    ask="Which tab does the world show in the app (an id such as chess)?"

@core.world.tabTitle core.key
    value=string
    card=one
