# k.objects/shards/structures: bridge, windmill, well, fence, gate, igloo, barn, tower, pyramid, kennel, mailbox. Parts with a primitive shape, a box in the 0 to 100 frame
# of the object (x right, y down), a draw order z and typical colours; points for lines and polygons.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: none (hand-written)

# bridge
@k.objects.bridge k.objects.object name=bridge core.source="hand-core 1"
@k.objects.bridge.deck k.objects.part of=bridge name=deck shape=rectangle x=5 y=55 w=90 h=8 z=2 colour=grey colour=brown core.source="hand-core 1"
@k.objects.bridge.left_pillar k.objects.part of=bridge name=left_pillar kind=pillar shape=rectangle x=22 y=55 w=8 h=35 z=1 colour=grey below=deck core.source="hand-core 1"
@k.objects.bridge.right_pillar k.objects.part of=bridge name=right_pillar kind=pillar shape=rectangle x=70 y=55 w=8 h=35 z=1 colour=grey below=deck core.source="hand-core 1"
@k.objects.bridge.arch k.objects.part of=bridge name=arch shape=arc x=30 y=63 w=40 h=22 z=1 colour=grey opens=down below=deck core.source="hand-core 1"
@k.objects.bridge.left_rail k.objects.part of=bridge name=left_rail kind=rail shape=line x=5 y=45 w=90 h=0 z=3 colour=black above=deck core.source="hand-core 1"
@k.objects.bridge.water k.objects.part of=bridge name=water shape=rectangle x=5 y=88 w=90 h=8 z=0 colour=blue below=deck core.source="hand-core 1"
@k.objects.bridge.left_rail.p1 k.objects.point part=$k.objects.bridge.left_rail n=1 x=5 y=45 core.source="hand-core 1"
@k.objects.bridge.left_rail.p2 k.objects.point part=$k.objects.bridge.left_rail n=2 x=95 y=45 core.source="hand-core 1"

