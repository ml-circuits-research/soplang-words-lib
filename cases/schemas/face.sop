# A face (avatar) as data, after PSys2's ui.avatar world: the three parts its grid tests
# (hair_back, shoulders, neck), each with colour and size (0.6..1.5, default 1) and a place;
# acts make, remove, change, place, ask; at most 40 items. Cases in cases/grid.cases.json.
@acts core.use world=std.acts
@face std.schema.world name=face doc="an avatar's face"
@t.hair_back core.type of=hair_back extends=std.schema.thing closed=true
@s.hair_back.colour core.slot of=hair_back key=colour
@s.hair_back.size core.slot of=hair_back key=size kind=number min=0.6 max=1.5 step=0.1 default=1
@s.hair_back.x core.slot of=hair_back key=x kind=number
@k.hair_back std.schema.kind of=hair_back world=face acts=make acts=remove acts=change acts=place acts=ask
@t.shoulders core.type of=shoulders extends=std.schema.thing closed=true
@s.shoulders.colour core.slot of=shoulders key=colour
@s.shoulders.size core.slot of=shoulders key=size kind=number min=0.6 max=1.5 step=0.1 default=1
@s.shoulders.x core.slot of=shoulders key=x kind=number
@k.shoulders std.schema.kind of=shoulders world=face acts=make acts=remove acts=change acts=place acts=ask
@t.neck core.type of=neck extends=std.schema.thing closed=true
@s.neck.colour core.slot of=neck key=colour
@s.neck.size core.slot of=neck key=size kind=number min=0.6 max=1.5 step=0.1 default=1
@s.neck.x core.slot of=neck key=x kind=number
@k.neck std.schema.kind of=neck world=face acts=make acts=remove acts=change acts=place acts=ask
