# k.objects/shards/vehicles: car, boat, plane, rocket, train, bicycle. Parts with a primitive shape, a box in the 0 to 100 frame
# of the object (x right, y down), a draw order z and typical colours; points for lines and polygons.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: none (hand-written)

# car
@k.objects.car k.objects.object name=car core.source="hand-core 1"
@k.objects.car.body k.objects.part of=car name=body shape=rectangle x=5 y=45 w=90 h=25 z=1 colour=red colour=blue colour=black colour=white core.source="hand-core 1"
@k.objects.car.cabin k.objects.part of=car name=cabin shape=polygon x=25 y=25 w=53 h=20 z=1 colour=red colour=blue colour=black colour=white above=body core.source="hand-core 1"
@k.objects.car.left_window k.objects.part of=car name=left_window kind=window shape=polygon x=30 y=29 w=18 h=14 z=2 colour=blue inside=cabin core.source="hand-core 1"
@k.objects.car.right_window k.objects.part of=car name=right_window kind=window shape=polygon x=52 y=29 w=21 h=14 z=2 colour=blue inside=cabin core.source="hand-core 1"
@k.objects.car.left_wheel k.objects.part of=car name=left_wheel kind=wheel shape=circle x=15 y=58 w=22 h=22 z=2 colour=black below=body core.source="hand-core 1"
@k.objects.car.right_wheel k.objects.part of=car name=right_wheel kind=wheel shape=circle x=63 y=58 w=22 h=22 z=2 colour=black below=body core.source="hand-core 1"
@k.objects.car.cabin.p1 k.objects.point part=$k.objects.car.cabin n=1 x=25 y=45 core.source="hand-core 1"
@k.objects.car.cabin.p2 k.objects.point part=$k.objects.car.cabin n=2 x=32 y=25 core.source="hand-core 1"
