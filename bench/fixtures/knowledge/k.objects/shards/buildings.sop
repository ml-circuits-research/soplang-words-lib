# k.objects/shards/buildings: house, castle, lighthouse. Parts with a primitive shape, a box in the 0 to 100 frame
# of the object (x right, y down), a draw order z and typical colours; points for lines and polygons.
# sources: hand-core 1 (hand-written in this repository)
# license: CC0-1.0
# script: none (hand-written)

# house
@k.objects.house k.objects.object name=house core.source="hand-core 1"
@k.objects.house.body k.objects.part of=house name=body shape=rectangle x=20 y=45 w=60 h=50 z=1 colour=red below=roof core.source="hand-core 1"
@k.objects.house.roof k.objects.part of=house name=roof shape=triangle x=12 y=15 w=76 h=30 z=2 colour=brown colour=red above=body core.source="hand-core 1"
@k.objects.house.chimney k.objects.part of=house name=chimney shape=rectangle x=62 y=18 w=10 h=17 z=0 colour=grey on=roof core.source="hand-core 1"
@k.objects.house.door k.objects.part of=house name=door shape=rectangle x=42 y=70 w=16 h=25 z=3 colour=brown inside=body centered=true core.source="hand-core 1"
@k.objects.house.left_window k.objects.part of=house name=left_window kind=window shape=square x=27 y=55 w=12 h=12 z=3 colour=blue inside=body left_of=door core.source="hand-core 1"
@k.objects.house.right_window k.objects.part of=house name=right_window kind=window shape=square x=61 y=55 w=12 h=12 z=3 colour=blue inside=body right_of=door core.source="hand-core 1"

# castle
@k.objects.castle k.objects.object name=castle core.source="hand-core 1"
@k.objects.castle.wall k.objects.part of=castle name=wall shape=rectangle x=15 y=40 w=70 h=55 z=1 colour=grey core.source="hand-core 1"
@k.objects.castle.left_tower k.objects.part of=castle name=left_tower kind=tower shape=rectangle x=5 y=20 w=20 h=75 z=2 colour=grey left_of=wall core.source="hand-core 1"
@k.objects.castle.right_tower k.objects.part of=castle name=right_tower kind=tower shape=rectangle x=75 y=20 w=20 h=75 z=2 colour=grey right_of=wall core.source="hand-core 1"
@k.objects.castle.left_roof k.objects.part of=castle name=left_roof kind=roof shape=triangle x=3 y=2 w=24 h=18 z=2 colour=red above=left_tower core.source="hand-core 1"
@k.objects.castle.right_roof k.objects.part of=castle name=right_roof kind=roof shape=triangle x=73 y=2 w=24 h=18 z=2 colour=red above=right_tower core.source="hand-core 1"
@k.objects.castle.gate k.objects.part of=castle name=gate shape=rectangle x=40 y=65 w=20 h=30 z=3 colour=brown inside=wall centered=true core.source="hand-core 1"
@k.objects.castle.left_merlon k.objects.part of=castle name=left_merlon kind=merlon shape=square x=30 y=34 w=6 h=6 z=1 colour=grey above=wall core.source="hand-core 1"
@k.objects.castle.middle_merlon k.objects.part of=castle name=middle_merlon kind=merlon shape=square x=47 y=34 w=6 h=6 z=1 colour=grey above=wall core.source="hand-core 1"
@k.objects.castle.right_merlon k.objects.part of=castle name=right_merlon kind=merlon shape=square x=64 y=34 w=6 h=6 z=1 colour=grey above=wall core.source="hand-core 1"

# lighthouse
@k.objects.lighthouse k.objects.object name=lighthouse core.source="hand-core 1"
@k.objects.lighthouse.tower k.objects.part of=lighthouse name=tower shape=polygon x=35 y=30 w=30 h=60 z=1 colour=white centered=true core.source="hand-core 1"
@k.objects.lighthouse.stripe k.objects.part of=lighthouse name=stripe shape=polygon x=37 y=55 w=26 h=15 z=2 colour=red inside=tower core.source="hand-core 1"
@k.objects.lighthouse.lamp k.objects.part of=lighthouse name=lamp shape=rectangle x=40 y=15 w=20 h=15 z=2 colour=yellow above=tower core.source="hand-core 1"
@k.objects.lighthouse.cap k.objects.part of=lighthouse name=cap shape=triangle x=36 y=3 w=28 h=12 z=2 colour=red above=lamp core.source="hand-core 1"
@k.objects.lighthouse.base k.objects.part of=lighthouse name=base shape=rectangle x=25 y=90 w=50 h=8 z=0 colour=grey below=tower core.source="hand-core 1"
@k.objects.lighthouse.door k.objects.part of=lighthouse name=door shape=rectangle x=46 y=78 w=8 h=12 z=3 colour=brown inside=tower centered=true core.source="hand-core 1"
@k.objects.lighthouse.tower.p1 k.objects.point part=$k.objects.lighthouse.tower n=1 x=35 y=90 core.source="hand-core 1"
@k.objects.lighthouse.tower.p2 k.objects.point part=$k.objects.lighthouse.tower n=2 x=65 y=90 core.source="hand-core 1"
@k.objects.lighthouse.tower.p3 k.objects.point part=$k.objects.lighthouse.tower n=3 x=58 y=30 core.source="hand-core 1"
@k.objects.lighthouse.tower.p4 k.objects.point part=$k.objects.lighthouse.tower n=4 x=42 y=30 core.source="hand-core 1"
@k.objects.lighthouse.stripe.p1 k.objects.point part=$k.objects.lighthouse.stripe n=1 x=37 y=70 core.source="hand-core 1"
@k.objects.lighthouse.stripe.p2 k.objects.point part=$k.objects.lighthouse.stripe n=2 x=63 y=70 core.source="hand-core 1"
@k.objects.lighthouse.stripe.p3 k.objects.point part=$k.objects.lighthouse.stripe n=3 x=61 y=55 core.source="hand-core 1"
@k.objects.lighthouse.stripe.p4 k.objects.point part=$k.objects.lighthouse.stripe n=4 x=39 y=55 core.source="hand-core 1"

# words
@k.objects.word.house core.word text=house text=houses text=home means=house of=k.objects.object.name core.source="hand-core 1"
@k.objects.word.castle core.word text=castle text=castles means=castle of=k.objects.object.name core.source="hand-core 1"
@k.objects.word.lighthouse core.word text=lighthouse text=lighthouses means=lighthouse of=k.objects.object.name core.source="hand-core 1"
@k.objects.word.part.merlon core.word text=merlon text=merlons means=merlon of=k.objects.part.kind core.source="hand-core 1"
@k.objects.word.part.roof core.word text=roof text=roofs means=roof of=k.objects.part.kind core.source="hand-core 1"
@k.objects.word.part.tower core.word text=tower text=towers means=tower of=k.objects.part.kind core.source="hand-core 1"
@k.objects.word.part.window core.word text=window text=windows means=window of=k.objects.part.kind core.source="hand-core 1"
