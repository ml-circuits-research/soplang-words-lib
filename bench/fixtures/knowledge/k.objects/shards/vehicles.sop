# rocket
@k.objects.rocket k.objects.object name=rocket core.source="hand-core 1"
@k.objects.rocket.body k.objects.part of=rocket name=body shape=rectangle x=35 y=25 w=30 h=55 z=1 colour=white colour=grey centered=true core.source="hand-core 1"
@k.objects.rocket.nose k.objects.part of=rocket name=nose shape=triangle x=35 y=3 w=30 h=22 z=1 colour=red above=body centered=true core.source="hand-core 1"
