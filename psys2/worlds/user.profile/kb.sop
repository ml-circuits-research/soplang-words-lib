@f.name user.profile.field
    label="Preferred name"
    section=basics
    prio=10
    card=one
    sens=none
    want="what to call you"
    example="Andy"
    q="What should I call you?"
    q="First things first: what name do you like to go by?"
    q="How would you like me to address you? A first name or nickname is perfect."
    q="Let us start with a name. What do I call you?"
    follow="Is that your full first name, or a nickname?"
    followMode=unclear
    ack="Nice to meet you, {v}!"
    ack="{v}, lovely to meet you."
    ack="Great, {v} it is."
    askable=true
    core.source="specs/12-profile.md"

@f.address user.profile.field
    label="How to address you"
    section=basics
    prio=5
    card=one
    sens=none
    want="how formal to be when I address you"
    example="first name"
    q="Should I stay on a first-name basis, or would you prefer something more formal?"
    q="Do you like it casual with first names, or a bit more formal?"
    q="When I talk to you, first name or something like Dr. or Ms.?"
    follow="Any title you would like me to use?"
    followMode=unclear
    ack="Understood: {v}."
    ack="Got it, I will keep it {v}."
    ack="Noted, {v}."
    needs=name
    askable=true
    core.source="specs/12-profile.md"

@f.location user.profile.field
    label="City or country"
    section=basics
    prio=3
    card=one
    sens=low
    want="where you are based (city or country, never an address)"
    example="Cluj, Romania"
    q="Which city or country do you call home? Just the general area is fine."
    q="Where in the world are you based, roughly?"
    q="Which part of the world are you in? A city or a country is enough."
    q="If you do not mind sharing, which city are you near?"
    follow="Do you like it there?"
    followMode=unclear
    ack="{v}, a good place to be based!"
    ack="Ah, {v}. Thanks!"
    ack="{v}, nice."
    askable=true
    core.source="specs/12-profile.md"

@f.role user.profile.field
    label="Current role"
    section=professional
    prio=9
    card=one
    sens=none
    want="what you do for work"
    example="software engineer"
    q="What do you do for a living?"
    q="What is your job, or what do you spend most of your days doing?"
    q="How do you earn your keep these days? What is your role?"
    q="Tell me about your work: what is your title or role?"
    follow="Do you work at a company or organisation, or on your own?"
    followKey=org
    followMode=always
    ack="{A}, that sounds like interesting work."
    ack="{A}: good to know."
    ack="{A}, nice!"
    askable=true
    core.source="specs/12-profile.md"

