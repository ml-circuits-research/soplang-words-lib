    value=any
    card=many
    ask="Which lexicons does this one inherit words from?"

@core.lexicon.exclude core.key
    value=atom
    card=many
    ask="Which inherited words are removed?"

@core.phrase.alt core.key
    value=atom
    card=many
    ask="Which literal alternatives (words joined by _)?"

@core.phrase.frame core.key
    value=atom
    card=one
    ask="Is it frame vocabulary (true, the default) or content (false)?"

@core.phrase.doc core.key
    value=string
    card=one
    ask="What is it?"

@core.note.text core.key
    value=string
    card=one
    ask="What does the note say?"

@core.observation core.type
    extends=core.thing
    doc="The host reports the outcome of an effect it executed (spec 07): which effect, whether it worked, and a detail."

@core.observation.effect core.key
    value=atom
    card=one
    ask="Which effect was executed?"
    required=true

@core.observation.ok core.key
    value=boolean
    card=one
    ask="Did the effect work?"

@core.observation.detail core.key
    value=string
    card=one
    ask="What did the host report?"
