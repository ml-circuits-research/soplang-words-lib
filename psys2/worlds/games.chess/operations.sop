@op.games.chess.move core.operation
    impl=move
    semantics=action
    action=chess.move
    doc="Plays the user move described by piece, squares, capture, castling or notation arguments; resolves ambiguity, asks for a promotion piece, explains illegal moves, and queues the engine reply."

@op.games.chess.can core.operation
    impl=can
    semantics=action
    action=chess.can
    doc="Answers whether a described move is legal, without playing it."

@op.games.chess.pick core.operation
    impl=pick
    semantics=action
    action=chess.pick
    doc="Resolves a pending \"which piece?\" question by origin square or ordinal (first, left)."

@op.games.chess.promote core.operation
    impl=promote
    semantics=action
    action=chess.promote
    doc="Chooses the piece for a pending pawn promotion."

@op.games.chess.moves core.operation
    impl=moves
    semantics=action
    action=chess.moves
    doc="Lists the legal moves of a piece, of one square or of all pieces, and highlights them on the board."

@op.games.chess.hint core.operation
    impl=hint
    semantics=action
    action=chess.hint
    doc="Asks the engine for a suggestion for the user and draws an arrow on the board."

@op.games.chess.status core.operation
    impl=status
    semantics=action
    action=chess.status
    doc="Tells who is ahead by material count and the game state."

@op.games.chess.check core.operation
    impl=check
    semantics=action
    action=chess.check
    doc="Tells whether a king is in check or checkmated."

@op.games.chess.last core.operation
    impl=last
    semantics=action
    action=chess.last
    doc="Tells the last move (of the system, of the user, or the last one played)."

@op.games.chess.describe core.operation
    impl=describe
    semantics=action
    action=chess.describe
    doc="Reads the position aloud, optionally for one side."

@op.games.chess.where core.operation
    impl=where
    semantics=action
    action=chess.where
    doc="Tells where pieces of a kind are."

@op.games.chess.count core.operation
    impl=count
    semantics=action
    action=chess.count
    doc="Counts pieces on the board."

@op.games.chess.lost core.operation
    impl=lost
    semantics=action
    action=chess.lost
    doc="Lists captured pieces."

@op.games.chess.turn core.operation
    impl=turn
    semantics=action
    action=chess.turn
    doc="Tells whose turn it is or which colour the user plays."

@op.games.chess.history core.operation
    impl=history
    semantics=action
    action=chess.history
    doc="Reads the move list."

@op.games.chess.level core.operation
    impl=level
    semantics=action
    action=chess.level
    doc="Sets or tells the playing level (1 to 8)."

@op.games.chess.fen core.operation
    impl=fen
    semantics=action
    action=chess.fen
    doc="Reads the position in FEN notation."

@op.games.chess.square core.operation
    impl=square
    semantics=action
    action=chess.square
    doc="Tells what stands on a square."

@op.games.chess.engineMove core.operation
    impl=engineMove
    semantics=action
    action=chess.engineMove
    doc="Asks the system to move now (when it is its turn)."

@op.games.chess.newGame core.operation
    impl=newGame
    semantics=action
    action=chess.new
    doc="Starts a new game (arg keep=true keeps a game in progress); the system opens when the user is black."

@op.games.chess.side core.operation
    impl=side
    semantics=action
    action=chess.side
    doc="Chooses the user colour (starts a new game) or swaps sides."

@op.games.chess.flip core.operation
    impl=flip
    semantics=action
    action=chess.flip
    doc="Turns the board around or shows it from one side."

@op.games.chess.undo core.operation
    impl=undo
    semantics=action
    action=chess.undo
    doc="Takes back the last move of the user together with the reply."

@op.games.chess.resign core.operation
    impl=resign
    semantics=action
    action=chess.resign
    doc="The user resigns."

@op.games.chess.draw core.operation
    impl=draw
    semantics=action
    action=chess.draw
    doc="The user offers a draw; the system accepts when it is not better."
