@core.world.tabAlias core.key
    value=atom
    card=many
    ask="What else can people call the tab (words joined by _)?"

@core.world.tabOrder core.key
    value=integer
    card=one
    ask="Where does the tab go in the tab bar (lower first)?"

@core.world.tabKind core.key
    value=atom
    card=one
    ask="Is the tab a tool or a game?"

@core.world.tabNew core.key
    value=atom
    card=one
    ask="Which action starts something new on the tab (new game, new document)?"

@core.world.tabHint core.key
    value=atom
    card=one
    ask="Which action gives a hint on the tab?"

@core.world.tabGiveUp core.key
    value=atom
    card=one
    ask="Which action gives up on the tab?"

@core.world.tabUndo core.key
    value=atom
    card=one
    ask="Which action undoes the last move on the tab (the shell's game controls emit it on the game tab)?"

@core.world.gameNew core.key
    value=atom
    card=one
    ask="Which action starts a new game (the shell's game controls emit it on the game tab)?"

@core.world.gameHint core.key
    value=atom
    card=one
    ask="Which action gives a hint (the shell's game controls emit it on the game tab)?"

@core.world.gameGiveUp core.key
    value=atom
    card=one
    ask="Which action gives up (the shell's game controls emit it on the game tab)?"

@core.world.gameUndo core.key
    value=atom
    card=one
    ask="Which action takes back the last move (the shell's game controls emit it on the game tab)?"

@core.pattern.match core.key
    value=string
    card=one
    ask="Which token pattern matches?"
    required=true

@core.pattern.emit core.key
    value=string
    card=one
    ask="Which wires are emitted?"
    required=true

@core.pattern.kind core.key
    value=atom
    card=one
    ask="statement, question, request or chat?"

@core.pattern.priority core.key
    value=integer
    card=one
    ask="Which priority?"

@core.pattern.tabOnly core.key
    value=boolean
    card=one
    ask="Does the pattern apply only while its world's tab is active?"

@core.pattern.tabFollow core.key
    value=boolean
    card=one
    ask="Is this a bare reading (a coordinate) that only the world of the active tab, the active game or a recently used world may claim?"

@core.pattern.signal core.key
    value=boolean
    card=one
    ask="Does the pattern carry an explicit signal of its world (a named shape, an arrow between names, a flowchart word), so it beats the active tab's own matches?"

@core.pattern.tabPriority core.key
    value=integer
    card=one
    ask="Which priority applies while the world's tab is active?"

@core.pattern.yieldsTo core.key
    value=atom
    card=many
    ask="Which world does a tier 2b setting give way to when that world is the tab or a recent world?"

@core.pattern.needsState core.key
    value=atom
    card=one
    ask="Which state path of its world must be non-empty for the pattern to apply (unless the world's tab is active)?"

@core.pattern.example core.key
    value=string
    card=many
    ask="Which sentence is an example?"

@core.pattern.canonical core.key
    value=string
    card=many
    ask="Which sentence is a canonical example (a clean natural sentence that help and \"Did you mean\" may offer; it is also an example of the pattern)?"

@core.pattern.doc core.key
    value=string
    card=one
    ask="What is it?"

@core.shape.family core.key
    value=atom
    card=one
    ask="Which family: set, do, ask.value, ask.count, ask.exists or list?"

@core.shape.verb core.key
    value=string
    card=one
    ask="Which verbs (alternatives a|b|c; _ joins words)? Imperative verbs, or have-verbs for ask.count and ask.exists."

@core.shape.obj core.key
    value=string
    card=one
    ask="Which object slot (name:class)?"

@core.shape.val core.key
    value=string
    card=one
    ask="Which value slot (name:class; family set)?"

@core.shape.noun core.key
    value=string
    card=one
    ask="Which property nouns (alternatives, for example color|colour)?"

@core.shape.det core.key
    value=string
    card=one
    ask="Which determiners may precede the object (default the|your|ur|my)?"

@core.shape.link core.key
    value=string
    card=one
    ask="Which words may link object and value in the imperative of family set (default to|into|be|as|a|an)?"

@core.shape.extra core.key
    value=string
    card=one
    ask="Which extra optional slot (name:class?) follows the value or object?"

@core.shape.emit core.key
    value=string
    card=one
    ask="Which wires are emitted (an emit template as in core.pattern.emit)?"

@core.shape.emitOpts core.key
    value=string
    card=one
    ask="Which wires does the options form emit (without it no options form is generated)?"

@core.shape.forms core.key
    value=string
    card=one
    ask="Which forms to generate (comma list; default every form of the family)?"

@core.shape.skip core.key
    value=string
    card=one
    ask="Which forms to leave out (comma list)?"

@core.shape.mod core.key
    value=string
    card=one
    ask="Which optional modifier group (alternatives and $macro ids) may precede the value (a bit, much)?"

@core.shape.objmod core.key
    value=string
    card=one
    ask="Which optional modifier group may precede the object (whole, entire)?"

@core.shape.pron core.key
    value=string
    card=one
    ask="Which pronouns may follow the verb in the question of a noun-only ask.value shape?"

@core.shape.rel core.key
    value=string
    card=one
    ask="Which relation words stand between the noun and the object of an ask.value shape (after, comes_after, follows)?"

@core.shape.cont core.key
    value=string
    card=one
    ask="Which container slot (name:class) does an ask.count shape count in (how many days in a WEEK)?"

@core.shape.objdet core.key
    value=atom
    card=one
    ask="none when no determiner may stand before the object of an ask.value shape?"

@core.shape.poss core.key
    value=atom
    card=one
    ask="true to also generate the possessive form of an ask.value shape (Japan's capital)?"

@core.shape.sample core.key
    value=string
    card=one
    ask="Which example word for each slot (p=eyes;c=blue)?"

@core.shape.priority core.key
    value=integer
    card=one
    ask="Which priority (short forms get priority minus 2)?"

@core.shape.kind core.key
    value=atom
    card=one
    ask="statement, question, request or chat (default by family and form)?"

@core.shape.example core.key
    value=string
    card=many
    ask="Which sentence is an extra example (put on the first generated pattern)?"

@core.shape.canonical core.key
    value=string
    card=many
    ask="Which generated sentence is canonical (offered by help)? Explicit shape examples are canonical too."

@core.shape.doc core.key
    value=string
    card=one
    ask="What is it?"

@core.operation.outputs core.key
    value=atom
    card=many
    ask="Which keys does it compute?"

@core.operation.inputs core.key
    value=atom
    card=many
    ask="Which keys does it read?"

@core.operation.impl core.key
    value=atom
    card=one
    ask="Which export of ops.mjs implements it?"
    required=true

@core.operation.semantics core.key
    value=atom
    card=one
    ask="query, compute or action?"

@core.operation.action core.key
    value=atom
    card=one
    ask="Which action name does it serve?"

@core.operation.doc core.key
    value=string
    card=one
    ask="What does it do?"

@core.template.for core.key
    value=atom
    card=one
    ask="Which key, operation, action or ack type does it render?"
    required=true

@core.template.status core.key
    value=atom
    card=one
    ask="Which answer status does it render?"

@core.template.mode core.key
    value=atom
    card=one
